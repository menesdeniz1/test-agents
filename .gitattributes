# Shell scripts MUST keep LF. With core.autocrlf=true (the Windows default)
# install.sh would otherwise be checked out with CRLF, and bash fails on the
# stray carriage return with "bad interpreter: /bin/bash^M".
*.sh text eol=lf

# PowerShell is fine either way, but CRLF is native on the platform it runs on.
*.ps1 text eol=crlf

# Everything else: normalize in the repo, let git pick on checkout.
* text=auto
